---
import { themeConfig } from '@/config'
import ThemeToggle from '@/components/ui/ThemeToggle.astro'
---

<header>
  <nav>
    <div class="nav-left">
      <a href="/" class="site-title">{themeConfig.site.title}</a>
    </div>
    <div class="nav-right">
      <div class="nav-links">
        <a href="/blog">Blog</a>
        <a href="/projects">Projects</a>
        <a href="/about">About</a>
      </div>
      {themeConfig.general.themeToggle && <ThemeToggle />}
    </div>
  </nav>
</header>
<style>
  header {
    margin: 0 0 2rem 0;
    padding-top: 1rem;
  }
  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .nav-left {
    display: flex;
    align-items: center;
    gap: 2.5rem;
  }
  .nav-right {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .site-title {
    font-weight: var(--font-weight-bold);
    font-size: 1.25rem;
  }
  .nav-links {
    display: flex;
    gap: 1.5rem;
  }
  header a {
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  header a:hover {
    color: var(--primary);
  }
</style>
