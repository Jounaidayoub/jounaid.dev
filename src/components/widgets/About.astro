---
import { getEntry } from 'astro:content'
import { render } from 'astro:content'

const aboutEntry = await getEntry('about', 'about')
// Check if there is actual content (excluding comments)
const hasContent = aboutEntry?.body ? aboutEntry.body.replace(/<!--[\s\S]*?-->/g, '').trim().length > 0 : false
const { Content } = hasContent && aboutEntry ? await render(aboutEntry) : { Content: null }
---

{
  hasContent && Content && (
    <div class="about-container">
      <div class="about prose">
        <Content />
      </div>
      <div class="pfp-placeholder" title="Profile Picture">
        <img src="/images/pfp.webp" alt="Profile picture" />
      </div>
    </div>
  )
}

<style>
  .about-container {
    display: flex;
    align-items: flex-start; /* Aligns to the top of the text column */
    justify-content: space-between;
    gap: 2rem;
  }

  .about:not(:empty) {
    margin-bottom: 0;
    flex: 1;
  }

  .pfp-placeholder {
    width: 5.5rem;
    height: 5.5rem;
    border-radius: 0.75rem;
    background-color: var(--theme-divider, #e5e7eb);
    border: 1px solid var(--theme-divider, #d1d5db);
    overflow: hidden;
    flex-shrink: 0;
    margin-top: 0.5rem; /* Aligns it perfectly with the first line of text (not too high, not too low) */
  }

  .pfp-placeholder img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  :global(.dark) .pfp-placeholder {
    background-color: #374151;
    border-color: #4b5563;
  }

  @media (max-width: 640px) {
    .about-container {
      flex-direction: column-reverse;
      gap: 1.25rem;
      align-items: flex-start;
    }
  }
</style>
