---
import { getEntry } from 'astro:content'
import { render } from 'astro:content'

const aboutEntry = await getEntry('about', 'about')
// Check if there is actual content (excluding comments)
const hasContent = aboutEntry?.body ? aboutEntry.body.replace(/<!--[\s\S]*?-->/g, '').trim().length > 0 : false
const { Content } = hasContent && aboutEntry ? await render(aboutEntry) : { Content: null }
---

{
  hasContent && Content && (
    <div class="about-container">
      <div class="about prose">
        <div class="pfp-wrapper">
          <div class="pfp-placeholder" title="Profile Picture">
            <img src="/images/pfp.webp" alt="Profile picture" />
          </div>
        </div>
        <Content />
      </div>
    </div>
  )
}

<style>
  .about-container {
    display: block;
  }

  .about:not(:empty) {
    margin-bottom: 0;
  }

  .pfp-wrapper {
    float: right;
    margin-left: 2rem;
    margin-bottom: 0.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    width: 6.5rem; /* Match the profile picture width */
  }

  .pfp-placeholder {
    width: 6.5rem;
    height: 6.5rem;
    border-radius: 1rem;
    background-color: var(--theme-divider, #e5e7eb);
    border: 1px solid var(--border);
    overflow: hidden;
    margin-top: 0.25rem;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    box-shadow: 0 4px 20px -4px rgba(0, 0, 0, 0.1);
  }

  .social-links {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
  }

  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
    transition: all 0.2s ease;
    border-bottom: 2px solid transparent;
    padding-bottom: 0.25rem;
  }

  .social-icon:hover {
    color: var(--primary);
    border-bottom-color: var(--primary);
  }

  .pfp-placeholder:hover {
    transform: rotate(2deg) scale(1.05);
    border-color: var(--text-tertiary);
    box-shadow: 0 8px 30px -6px rgba(0, 0, 0, 0.15);
  }

  .pfp-placeholder img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    margin: 0;
    transition: transform 0.5s ease;
  }

  .pfp-placeholder:hover img {
    transform: scale(1.1);
  }

  :global(.dark) .pfp-placeholder {
    background-color: #374151;
    box-shadow: 0 4px 20px -4px rgba(0, 0, 0, 0.3);
  }

  :global(.dark) .pfp-placeholder:hover {
    box-shadow: 0 8px 30px -6px rgba(0, 0, 0, 0.4);
  }

  /* Clearfix for about container just in case content is smaller than image */
  .about::after {
    content: '';
    display: table;
    clear: both;
  }

  @media (max-width: 640px) {
    .pfp-wrapper {
      float: none;
      margin-left: 0;
      margin-bottom: 1.5rem;
      align-items: flex-start;
      gap: 0.75rem;
      width: 5.5rem; /* Match the new smaller profile picture width */
    }

    .pfp-placeholder {
      width: 5.5rem;
      height: 5.5rem;
      margin-top: 0;
    }
  }
</style>
