---
const featuredProjects = [
  {
    title: 'DoTunnel',
    description:
      'Expose your localhost to the internet easily. A lightweight tunnel proxy built on Cloudflare Durable Objects.'
  },
  {
    title: 'BrowserPilot',
    description:
      'An AI agent that lives in your browser sidepanel to automate browsing tasks — navigate, summarize, fill forms, and handle repetitive tasks.'
  },
  {
    title: 'OpenCode Whisper',
    description:
      'A voice-to-prompt TUI plugin for OpenCode that transcribes speech into prompts using Groq Whisper API.'
  }
]
---

<section class="featured-projects">
  <div class="section-header">
    <h2 class="section-title">Selected Projects</h2>
    <a href="/projects" class="view-all">View all &rarr;</a>
  </div>
  <ul class="project-list">
    {featuredProjects.map((project) => (
      <li class="project-item">
        <a href="/projects" class="project-link">{project.title}</a>
        <p class="project-desc">{project.description}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  .featured-projects {
    margin: 2.5rem 0;
  }
  .section-header {
