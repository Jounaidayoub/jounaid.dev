---
interface Props {
  title: string
  description: string
  video?: string
  image?: string[]
  codeLink?: string
  demoLink?: string
}
const { title, description, video, image, codeLink, demoLink } = Astro.props
---

<div class="project-card">
  <div class="project-preview">
    {
      video ? (
        <video src={'/' + video} autoplay loop muted playsinline class="preview-media" />
      ) : image && image.length > 0 ? (
        <img src={'/' + image[0]} alt={title} class="preview-media" />
      ) : (
        <div class="preview-placeholder">No preview</div>
      )
    }
  </div>
  <div class="project-info">
    <h3 class="project-title">{title}</h3>
    <p class="project-desc">{description}</p>
    <div class="project-links">
      {
        demoLink && (
          <a href={demoLink} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
            Site &nearr;
          </a>
        )
      }
      {
        codeLink && (
          <a href={codeLink} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            Code &nearr;
          </a>
        )
      }
    </div>
  </div>
</div>

<style>
  .project-card {
    display: flex;
    flex-direction: row;
    gap: 1rem;
    padding: 0;
    background-color: transparent;
    transition: transform 0.2s ease;
    align-items: flex-start;
  }
  .project-preview {
    width: 240px;
    flex-shrink: 0;
    border-radius: 8px;
    overflow: hidden;
    background-color: var(--code-bg);
    border: 1px solid var(--border);
    transition: border-color 0.2s ease;
  }
  .project-card:hover .project-preview {
    border-color: var(--text-tertiary);
  }
  .preview-media {
    width: 100%;
    height: auto;
    max-height: 160px;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }
  .project-card:hover .preview-media {
    transform: scale(1.02);
  }
  .preview-placeholder {
    width: 100%;
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-tertiary);
    font-size: var(--font-size-s);
  }
  .project-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0;
    flex: 1;
    min-width: 0;
  }
  .project-title {
    font-size: var(--font-size-m);
    font-weight: 500;
    margin: 0;
    color: var(--text-primary);
  }
  .project-desc {
    font-size: var(--font-size-s);
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.5;
  }
  .project-links {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }
  .btn {
    font-size: var(--font-size-s);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  @media (max-width: 640px) {
    .project-card {
      flex-direction: column;
    }
    .project-preview {
      width: 100%;
    }
  }
  .btn-primary {
    color: var(--text-primary);
    font-weight: 500;
  }
  .btn-primary:hover {
    color: var(--primary);
  }
  .btn-secondary {
    color: var(--text-secondary);
  }
  .btn-secondary:hover {
    color: var(--primary);
  }
</style>
