{
  "name": "astro-chiri",
  "type": "module",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "pnpm exec tsx scripts/toggle-proxy.ts",
    "resume": "pnpm run resume:en && pnpm run resume:fr",
    "resume:en": "typst compile --input data=data.toml basic-resume/main.typ public/resume.pdf",
    "resume:fr": "typst compile --input data=data-fr.toml basic-resume/main.typ public/resume-fr.pdf",
    "build": "pnpm run typecheck  && astro build",
    "typecheck": "pnpm run typecheck:ts && astro check",
    "typecheck:ts": "tsc --noEmit",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "new": "tsx scripts/new-post.ts",
    "transcribe": "tsx scripts/transcribe.ts",
    "update-theme": "tsx scripts/update-theme.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.5.0",
    "@astrojs/mdx": "^5.0.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^6.3.1",
    "astro-mermaid": "^2.1.0",
    "astro-og-canvas": "^0.13.0",
    "canvaskit-wasm": "^0.41.1",
    "feed": "^5.2.1",
    "katex": "^0.16.45",
    "markdown-it": "^14.1.1",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^11.15.0",
    "node-html-parser": "^7.1.0",
    "reading-time": "^1.5.0",
    "rehype-katex": "^7.0.1",
    "remark-directive": "^4.0.0",
    "remark-math": "^6.0.0",
    "sanitize-html": "^2.17.3",
    "sharp": "^0.34.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@types/markdown-it": "^14.1.2",
    "@types/sanitize-html": "^2.16.1",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "wrangler": "^4.90.0"
  }
}
